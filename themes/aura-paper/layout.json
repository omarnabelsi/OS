{
  "regions": ["background", "desktop", "taskbar", "windows", "overlay"],
  "navBar": {
    "position": "top",
    "items": ["home", "games", "apps", "files", "media", "settings"]
  },
  "desktop": {
    "grid": { "cell": 104, "gap": 12, "snap": true },
    "defaultItems": [
      { "kind": "folder", "folder": "smart:games", "x": 0, "y": 0 },
      { "kind": "folder", "folder": "smart:apps", "x": 0, "y": 1 },
      { "kind": "folder", "folder": "smart:favourites", "x": 0, "y": 2 },
      { "kind": "folder", "folder": "smart:recently-played", "x": 0, "y": 3 }
    ]
  },
  "folderShapes": [
    {
      "id": "binder",
      "asset": "assets/folders/binder.svg",
      "height": 148,
      "radius": "2px 4px 4px 4px",
      "tab": { "width": 104, "height": 14, "radius": "3px 3px 0 0" }
    },
    {
      "id": "envelope",
      "asset": "assets/folders/envelope.svg",
      "height": 112,
      "radius": "3px",
      "offsetTop": 18
    },
    { "id": "crate", "asset": "assets/folders/crate.svg", "height": 148, "radius": "3px" }
  ],
  "home": {
    "rows": [
      { "id": "recent", "title": "Recently played", "filter": { "sort": "last_played", "limit": 12 } },
      { "id": "favourites", "title": "Favourites", "filter": { "favouritesOnly": true } },
      { "id": "games", "title": "All games", "filter": { "type": "game" } }
    ]
  },
  "background": { "kind": "image", "path": "assets/wallpapers/paper.svg" },
  "fallbackBackground": { "kind": "color", "hex": "#f3eee4" }
}
